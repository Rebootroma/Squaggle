{
  "name": "facetime-quote-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.2 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "start": "node --env-file=.env.local agent.mjs start",
    "web": "node --env-file=.env.local quote-server.mjs",
    "estimate": "node estimator.mjs",
    "search": "node keenable.mjs",
    "render-face": "node scripts/render-face.mjs",
    "check": "for f in *.mjs scripts/*.mjs; do node --check \"$f\" || exit 1; done; echo check ok",
    "help": "node agent.mjs --help"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.2.0",
    "@livekit/agents": "1.8.0",
    "@livekit/agents-plugin-anthropic": "1.8.0",
    "@livekit/agents-plugin-elevenlabs": "1.8.0",
    "@livekit/agents-plugin-openai": "1.8.0",
    "@livekit/rtc-node": "0.13.35",
    "jpeg-js": "^0.4.4",
    "zod": "^4.6.7"
  }
}

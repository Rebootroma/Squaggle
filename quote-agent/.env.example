# Fill these in privately. All three LiveKit values must belong to one project.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# A model API key with Realtime access and available API credits.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# A name no other team uses. chert dev and chert doctor read it from .env.local.
AGENT_NAME=team-otter-video

# ---- Quote agent (added) ----
# Contractor who approves quotes (E.164). Receives the iMessage with the approve link.
CONTRACTOR_PHONE=
CONTRACTOR_NAME=Demo Plumbing Co.
CONTRACTOR_RATE=125
# Demo homeowner number; the agent also asks for it on the call. Receives the approved quote text.
HOMEOWNER_PHONE=
# Chert console → API keys → Reveal (bearer secret for iMessage). Leave empty to dry-run.
CHERT_SIGNING_SECRET=
# Optional: Keenable key (redeem BETA200). Empty = keyless /public endpoint.
KEENABLE_API_KEY=
# Vision model for camera snapshots (any OpenAI-compatible endpoint). Defaults to OpenAI + OPENAI_API_KEY.
VISION_MODEL=gpt-5-mini
VISION_BASE_URL=
VISION_API_KEY=
# Realtime voice model
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=marin
# Quote web server (npm run web). PUBLIC_URL is what goes in texts: use your tunnel/LAN URL for phones.
QUOTE_SERVER_URL=http://localhost:3000
PUBLIC_URL=http://localhost:3000
PORT=3000

# ---- Claude, ElevenLabs, pipeline voice (added) ----
# Claude reads the camera (vision) whenever this is set, and runs the conversation when OPENAI_API_KEY is empty.
ANTHROPIC_API_KEY=
# Defaults: claude-opus-5-5 for both. VISION_EFFORT defaults to low.
CLAUDE_VISION_MODEL=
CLAUDE_LLM_MODEL=
VISION_EFFORT=
# Voice without an OpenAI key: LiveKit Inference speech-to-text and text-to-speech (billed to the LiveKit project).
# Optional overrides: STT_MODEL, LLM_MODEL (a LiveKit Inference model; overrides Claude), TTS_MODEL.
# ElevenLabs voice for the pipeline (optional). Empty = LiveKit Inference voice.
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=
# Chert FaceTime project API key (facetime.trychert.com/api, read-only use here). Not the Messaging secret.
CHERT_FACETIME_API_KEY=
